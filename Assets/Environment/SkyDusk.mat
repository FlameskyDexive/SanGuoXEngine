            "_vertexSource": "\n#ifndef XENGINE_CG\r\n#define XENGINE_CG\r\n\n#ifndef SHADER_SHADERVARIABLES\r\n#define SHADER_SHADERVARIABLES\r\n\r\n// Global Uniform Buffer containing per-frame shared rendering data\r\n// Uses std140 layout for compatibility across all GPUs\r\n// This data is uploaded once per frame and is constant across all draw calls\r\n// Note: binding qualifier requires GLSL 420+, otherwise binding is set via glUniformBlockBinding in C# code\r\n#if __VERSION__ >= 420\r\nlayout(std140, binding = 0) uniform GlobalUniforms\r\n#else\r\nlayout(std140) uniform GlobalUniforms\r\n#endif\r\n{\r\n    // Camera matrices\r\n    mat4 xengine_MatV;\r\n    mat4 xengine_MatIV;\r\n    mat4 xengine_MatP;\r\n    mat4 xengine_MatVP;\r\n    mat4 xengine_PrevViewProj;\r\n    mat4 xengine_MatIP;\r\n    mat4 xengine_MatIVP;\r\n    mat4 xengine_MatVP_NonJittered;\r\n\r\n    // Camera parameters\r\n    vec3 _WorldSpaceCameraPos;\r\n    float _padding0;\r\n\r\n    vec4 _ProjectionParams;\r\n    vec4 _ScreenParams;\r\n    vec2 _CameraJitter;\r\n    vec2 _CameraPreviousJitter;\r\n\r\n    // Time parameters\r\n    vec4 _Time;\r\n    vec4 _SinTime;\r\n    vec4 _CosTime;\r\n    vec4 xengine_DeltaTime;\r\n};\r\n\r\n// Per-object uniforms (set per draw call)\r\nuniform mat4 xengine_ObjectToWorld;\r\nuniform mat4 xengine_WorldToObject;\r\nuniform mat4 xengine_PrevObjectToWorld;\r\nuniform int _ObjectID;\r\nuniform int _RenderingLayerMask;\r\n\r\n#define XENGINE_MATRIX_V xengine_MatV\r\n#define XENGINE_MATRIX_VP_PREVIOUS xengine_PrevViewProj\r\n#define XENGINE_MATRIX_I_V xengine_MatIV\r\n#define XENGINE_MATRIX_P xengine_MatP\r\n#define XENGINE_MATRIX_VP xengine_MatVP\r\n#define XENGINE_MATRIX_I_P xengine_MatIP\r\n#define XENGINE_MATRIX_I_VP xengine_MatIVP\r\n#define XENGINE_MATRIX_VP_NONJITTERED xengine_MatVP_NonJittered\r\n#define XENGINE_MATRIX_M xengine_ObjectToWorld\r\n#define XENGINE_MATRIX_M_PREVIOUS xengine_PrevObjectToWorld\r\n\r\n// Derived matrices\r\nmat4 xengine_MatMV = xengine_MatV * xengine_ObjectToWorld;\r\nmat4 xengine_MatMVP = xengine_MatVP * xengine_ObjectToWorld;\r\nmat4 xengine_MatTMV = transpose(xengine_MatV * xengine_ObjectToWorld);\r\nmat4 xengine_MatITMV = transpose(xengine_WorldToObject * xengine_MatIV);\r\n\r\n#define XENGINE_MATRIX_MV xengine_MatMV\r\n#define XENGINE_MATRIX_MVP xengine_MatMVP\r\n#define XENGINE_MATRIX_T_MV xengine_MatTMV\r\n#define XENGINE_MATRIX_IT_MV xengine_MatITMV\r\n\r\n#endif\n\n#define XENGINE_PI            3.14159265359\r\n#define XENGINE_TWO_PI        6.28318530718\r\n#define XENGINE_FOUR_PI       12.56637061436\r\n#define XENGINE_INV_PI        0.31830988618\r\n#define XENGINE_INV_TWO_PI    0.15915494309\r\n#define XENGINE_INV_FOUR_PI   0.07957747155\r\n#define XENGINE_HALF_PI       1.57079632679\r\n#define XENGINE_INV_HALF_PI   0.636619772367\r\n\r\n// Colors ===========================================================\r\n// http://chilliant.blogspot.com.au/2012/08/srgb-approximations-for-hlsl.html?m=1\r\nvec3 linearToGammaSpace(vec3 lin)\r\n{\r\n    return max(1.055 * pow(max(lin, vec3(0.0)), vec3(0.416666667)) - 0.055, 0.0);\r\n}\r\n\r\n// http://chilliant.blogspot.com.au/2012/08/srgb-approximations-for-hlsl.html?m=1\r\nvec3 gammaToLinearSpace(vec3 gamma)\r\n{\r\n    return gamma * (gamma * (gamma * 0.305306011 + 0.682171111) + 0.012522878);\r\n}\r\n\r\n// Decode only authored color RGB stored in a non-sRGB texture. Hardware-sRGB and\r\n// linear/HDR samples pass through exactly; alpha and data textures never enter here.\r\nvec3 DecodeColorTexture(vec3 sampleColor, float srgbDecode)\r\n{\r\n    if (srgbDecode <= 0.0) return sampleColor;\r\n    vec3 low = sampleColor / 12.92;\r\n    vec3 high = pow(max((sampleColor + 0.055) / 1.055, vec3(0.0)), vec3(2.4));\r\n    return mix(high, low, lessThanEqual(sampleColor, vec3(0.04045)));\r\n}\r\n// ============================================================================\r\n\r\nfloat linearizeDepth(float depth, float near, float far) \r\n{\r\n    float z = depth * 2.0 - 1.0; // Back to NDC [-1,1] range\r\n    return (2.0 * near * far) / (far + near - z * (far - near));\r\n}\r\n\r\nfloat linearizeDepthFromProjection(float depth) {\r\n    return linearizeDepth(depth, _ProjectionParams.y, _ProjectionParams.z);\r\n}\r\n\r\nfloat getFovFromProjectionMatrix(mat4 proj)\r\n{\r\n    // proj[1][1] is M11, the Y scale\r\n    // FOV = 2 * atan(1/M11)\r\n    return 2.0 * atan(1.0 / proj[1][1]);\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n\r\nvec3 projectAndDivide(mat4 matrix, vec3 pos) {\r\n    vec4 p = matrix * vec4(pos, 1.0);\r\n    return p.xyz / p.w;\r\n}\r\n\r\nvec3 getScreenPos(vec2 tc, sampler2D depthSampler) {\r\n\treturn vec3(tc, texture(depthSampler, tc).x);\r\n}\r\nvec3 getScreenPos(vec2 tc, float depth) {\r\n\treturn vec3(tc, depth);\r\n}\r\n\r\nvec3 getScreenFromViewPos(vec3 viewPos) {\r\n\tvec3 p = projectAndDivide(XENGINE_MATRIX_P, viewPos);\r\n\treturn p * 0.5 + 0.5;\r\n}\r\n\r\nvec3 getNDCFromScreenPos(vec3 screenPos) {\r\n\treturn screenPos * 2.0 - 1.0;\r\n}\r\n\r\nvec3 getViewFromScreenPos(vec3 screenPos) {\r\n\treturn projectAndDivide(XENGINE_MATRIX_I_P, getNDCFromScreenPos(screenPos));\r\n}\r\n\r\nvec3 getViewPos(vec2 tc, sampler2D depthSampler) {\r\n\treturn getViewFromScreenPos(getScreenPos(tc, depthSampler));\r\n}\r\nvec3 getViewPos(vec2 tc, float depth) {\r\n\treturn getViewFromScreenPos(getScreenPos(tc, depth));\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n// Math Utilities\r\n\r\n#define saturate(x) clamp(x, 0.0, 1.0)\r\n#define rcp(x) (1.0 / (x))\r\n#define max0(x) max(x, 0.0)\r\n\r\n// Min/Max of vector components\r\nfloat minOf(vec2 v) { return min(v.x, v.y); }\r\nfloat minOf(vec3 v) { return min(v.x, min(v.y, v.z)); }\r\nfloat minOf(vec4 v) { return min(v.x, min(v.y, min(v.z, v.w))); }\r\nfloat maxOf(vec2 v) { return max(v.x, v.y); }\r\nfloat maxOf(vec3 v) { return max(v.x, max(v.y, v.z)); }\r\nfloat maxOf(vec4 v) { return max(v.x, max(v.y, max(v.z, v.w))); }\r\n\r\n// Squared dot product\r\nfloat sdot(vec2 x) { return dot(x, x); }\r\nfloat sdot(vec3 x) { return dot(x, x); }\r\nfloat sdot(vec4 x) { return dot(x, x); }\r\n\r\n// Square function\r\nfloat sqr(float x) { return x * x; }\r\nvec2 sqr(vec2 x) { return x * x; }\r\nvec3 sqr(vec3 x) { return x * x; }\r\nvec4 sqr(vec4 x) { return x * x; }\r\n\r\n// Linear step with saturation\r\nfloat linearstep(float a, float b, float x) {\r\n\treturn saturate((x - a) / (b - a));\r\n}\r\n\r\n// Fast approximations for trigonometric functions\r\nfloat fastSign(float x) {\r\n\treturn x >= 0.0 ? 1.0 : -1.0;\r\n}\r\n\r\n// Fast acos approximation using polynomial\r\nfloat fastAcos(float x) {\r\n\tfloat y = abs(x);\r\n\tfloat p = -0.0187293 * y + 0.0742610;\r\n\tp = p * y - 0.2121144;\r\n\tp = p * y + 1.5707288;\r\n\tp = p * sqrt(1.0 - y);\r\n\treturn x >= 0.0 ? p : XENGINE_PI - p;\r\n}\r\n\r\n// Extract diagonal from matrix\r\nvec2 diagonal2(mat4 m) { return vec2(m[0].x, m[1].y); }\r\nvec3 diagonal3(mat4 m) { return vec3(m[0].x, m[1].y, m[2].z); }\r\n\r\n// Trigonometric utilities\r\nvec2 cossin(float x) { return vec2(cos(x), sin(x)); }\r\n\r\n// ----------------------------------------------------------------------------\r\n// Color Utilities\r\n\r\n// Luminance calculation (Rec. 709 coefficients)\r\nfloat luminance(vec3 color) {\r\n\treturn dot(color, vec3(0.2126, 0.7152, 0.0722));\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n// Random Number Generation\r\n\r\nuint triple32(uint x) {\r\n\t// https://nullprogram.com/blog/2018/07/31/\r\n\tx ^= x >> 17;\r\n\tx *= 0xed5ad4bbu;\r\n\tx ^= x >> 11;\r\n\tx *= 0xac4c1b51u;\r\n\tx ^= x >> 15;\r\n\tx *= 0x31848babu;\r\n\tx ^= x >> 14;\r\n\treturn uint(x);\r\n}\r\n\r\nstruct NoiseGenerator {\r\n\tuint currentNum;\r\n};\r\n\r\nNoiseGenerator createNoiseGenerator(vec4 glFragCoord) {\r\n    // Create seed from pixel coordinates\r\n    uint x = uint(glFragCoord.x);\r\n    uint y = uint(glFragCoord.y);\r\n    uint seed = triple32(x + y * uint(_ScreenParams.x));\r\n\treturn NoiseGenerator(seed);\r\n}\r\n\r\nNoiseGenerator createNoiseGenerator(vec4 glFragCoord, uint frameIndex) {\r\n    // Create seed from pixel coordinates + frame index for temporal variation\r\n    uint x = uint(glFragCoord.x);\r\n    uint y = uint(glFragCoord.y);\r\n    uint seed = triple32(x + y * uint(_ScreenParams.x) + frameIndex * 1973u);\r\n\treturn NoiseGenerator(seed);\r\n}\r\n\r\nuint randNext(inout NoiseGenerator gen)\r\n{\r\n    gen.currentNum = triple32(gen.currentNum);\r\n    return gen.currentNum;\r\n}\r\n\r\nuvec2 randNext2(inout NoiseGenerator gen) { return uvec2(randNext(gen), randNext(gen)); }\r\nuvec3 randNext3(inout NoiseGenerator gen) { return uvec3(randNext2(gen), randNext(gen)); }\r\nuvec4 randNext4(inout NoiseGenerator gen) { return uvec4(randNext3(gen), randNext(gen)); }\r\n\r\nfloat randNextF(inout NoiseGenerator gen) { return float(randNext(gen)) / float(0xffffffffu); }\r\nvec2 randNext2F(inout NoiseGenerator gen) { return vec2(randNext2(gen)) / float(0xffffffffu); }\r\nvec3 randNext3F(inout NoiseGenerator gen) { return vec3(randNext3(gen)) / float(0xffffffffu); }\r\nvec4 randNext4F(inout NoiseGenerator gen) { return vec4(randNext4(gen)) / float(0xffffffffu); } \r\n\r\n// Simple hash-based random for per-pixel variation\r\nfloat hash1(vec2 p) {\r\n\tvec3 p3 = fract(vec3(p.xyx) * 443.897);\r\n\tp3 += dot(p3, p3.zyx + 19.19);\r\n\treturn fract((p3.x + p3.y) * p3.z);\r\n}\r\n\r\nvec2 hash2(vec2 p) {\r\n\tvec3 p3 = fract(vec3(p.xyx) * vec3(443.897, 441.423, 437.195));\r\n\tp3 += dot(p3, p3.yzx + 19.19);\r\n\treturn fract((p3.xx + p3.yz) * p3.zy);\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n// Sampling Utilities\r\n\r\n// Sample cosine-weighted hemisphere around a normal\r\nvec3 SampleCosineHemisphere(vec3 normal, vec2 xy) {\r\n\tfloat phi = XENGINE_TWO_PI * xy.x;\r\n\tfloat cosTheta = xy.y * 2.0 - 1.0;\r\n\tfloat sinTheta = sqrt(saturate(1.0 - cosTheta * cosTheta));\r\n\tvec3 hemisphere = vec3(cossin(phi) * sinTheta, cosTheta);\r\n\r\n\tvec3 cosineVector = normalize(normal + hemisphere);\r\n\treturn cosineVector * fastSign(dot(cosineVector, normal));\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n// Depth Utilities\r\n\r\n// Convert screen-space depth to view-space depth\r\nfloat ScreenToViewDepth(float depth) {\r\n\tfloat z = depth * 2.0 - 1.0; // Back to NDC\r\n\treturn -XENGINE_MATRIX_P[3].z / (XENGINE_MATRIX_P[2].z + z);\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n// Reprojection Utilities\r\n\r\n// Reproject current screen position to previous frame using motion\r\nvec3 Reproject(vec2 screenUV, float depth, mat4 prevViewProj) {\r\n\t// Get current view space position\r\n\tvec3 viewPos = getViewPos(screenUV, depth);\r\n\r\n\t// Transform to world space\r\n\tvec4 worldPos = XENGINE_MATRIX_I_V * vec4(viewPos, 1.0);\r\n\r\n\t// Transform to previous frame's clip space\r\n\tvec4 prevClip = prevViewProj * worldPos;\r\n\r\n\t// Perspective divide\r\n\tvec3 prevNDC = prevClip.xyz / prevClip.w;\r\n\r\n\t// Convert to screen space [0,1]\r\n\tvec3 prevScreen = prevNDC * 0.5 + 0.5;\r\n\r\n\treturn prevScreen;\r\n}\r\n\r\n// Check if reprojection is valid (no disocclusion)\r\nbool IsReprojectionValid(vec2 prevUV, float currentDepth, float prevDepth, vec3 currentNormal, vec3 prevNormal) {\r\n\t// Out of screen\r\n\tif (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0)\r\n\t\treturn false;\r\n\r\n\t// Depth discontinuity check\r\n\tfloat depthDiff = abs(currentDepth - prevDepth);\r\n\tif (depthDiff > 0.01)\r\n\t\treturn false;\r\n\r\n\t// Normal discontinuity check\r\n\tfloat normalDot = dot(currentNormal, prevNormal);\r\n\tif (normalDot < 0.9)\r\n\t\treturn false;\r\n\r\n\treturn true;\r\n}\r\n\r\n// Normal Mapping ===========================================================\r\n\r\n// Apply a tangent-space normal map to a world-space normal.\r\n// If tangents are available (HAS_TANGENTS), constructs a TBN matrix and transforms\r\n// the sampled normal. Otherwise returns the interpolated world normal as-is.\r\n//\r\n// Usage:\r\n//   vec3 worldNormal = ApplyNormalMap(normalTex, uv, vNormal, vTangent, vBitangent);\r\n//\r\n// For shaders without normal maps, just use normalize(vNormal) directly.\r\nvec3 ApplyNormalMap(sampler2D normalTex, vec2 uv, vec3 normal, vec3 tangent, vec3 bitangent)\r\n{\r\n#ifdef HAS_TANGENTS\r\n    mat3 TBN = mat3(normalize(tangent), normalize(bitangent), normalize(normal));\r\n    vec3 normalTS = texture(normalTex, uv).rgb * 2.0 - 1.0;\r\n    return normalize(TBN * normalTS);\r\n#else\r\n    return normalize(normal);\r\n#endif\r\n}\r\n\r\n// Encode a world-space normal to view-space [0,1] range for the depth-normals pre-pass.\r\nvec4 EncodeViewNormal(vec3 worldNormal)\r\n{\r\n    vec3 viewNormal = normalize(mat3(XENGINE_MATRIX_V) * worldNormal);\r\n    return vec4(viewNormal * 0.5 + 0.5, float(_RenderingLayerMask) / 255.0);\r\n}\r\n\r\nvec3 DecodeViewNormal(vec4 encoded)\r\n{\r\n    vec3 viewNormal = encoded.xyz * 2.0 - 1.0;\r\n    return normalize(mat3(XENGINE_MATRIX_I_V) * viewNormal);\r\n}\r\n\r\n// Camera-centered sky dome: drop view translation so the mesh is not a world-space sphere.\r\n// Perspective already fills the far plane. Ortho maps a unit dome to a tiny NDC circle\r\n// (P scales by 2/orthoSize). Scale XY well past the NDC corners so a coarse sphere\r\n// tessellation still covers the rectangle (mesh radius ~0.95, inscribed-polygon chords).\r\nvec4 TransformSkyboxClip(vec3 objectPos)\r\n{\r\n    vec3 viewDir = mat3(XENGINE_MATRIX_V) * objectPos;\r\n    vec4 clip = XENGINE_MATRIX_P * vec4(viewDir, 1.0);\r\n    vec4 origin = XENGINE_MATRIX_P * vec4(0.0, 0.0, 0.0, 1.0);\r\n    if (abs(origin.w) > 0.5)\r\n    {\r\n        clip.x = viewDir.x * 4.0 * origin.w;\r\n        clip.y = viewDir.y * 4.0 * origin.w;\r\n    }\r\n    clip.z = clip.w;\r\n    // Ortho flattens the dome along view Z, so with ZTest Off the behind-camera hemisphere\r\n    // lands on the same pixels as the sky and submission order decides each pixel.\r\n    // Perspective is safe (w = -viewZ hardware-clips it); here push those verts past the\r\n    // far plane so the clipper removes them.\r\n    if (abs(origin.w) > 0.5 && viewDir.z > 0.0)\r\n        clip.z = 2.0 * abs(clip.w) + 1.0;\r\n    return clip;\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n\r\n\r\n#endif\r\n\n\n\n#ifndef SHADER_VERTEXATTRIBUTES\r\n#define SHADER_VERTEXATTRIBUTES\r\n\r\n// =============================================================\r\n//  Vertex Input Attributes\r\n// =============================================================\r\n\r\n\t\tlayout (location = 0) in vec3 vertexPosition;\r\n\r\n#ifdef HAS_UV\r\n\t\tlayout (location = 1) in vec2 vertexTexCoord0;\r\n#else\r\n\t\tvec2 vertexTexCoord0 = vec2(0.0, 0.0);\r\n#endif\r\n\r\n#ifdef HAS_UV2\r\n\t\tlayout (location = 2) in vec2 vertexTexCoord1;\r\n#else\r\n\t\tvec2 vertexTexCoord1 = vec2(0.0, 0.0);\r\n#endif\r\n\r\n#ifdef HAS_NORMALS\r\n\t\tlayout (location = 3) in vec3 vertexNormal;\r\n#else\r\n\t\tvec3 vertexNormal = vec3(0.0, 1.0, 0.0);\r\n#endif\r\n\r\n#ifdef HAS_COLORS\r\n\t\tlayout (location = 4) in vec4 vertexColor;\r\n#else\r\n\t\tvec4 vertexColor = vec4(1.0, 1.0, 1.0, 1.0);\r\n#endif\r\n\r\n#ifdef HAS_TANGENTS\r\n\t\tlayout (location = 5) in vec4 vertexTangent; // xyz = tangent direction, w = bitangent sign\r\n#else\r\n\t\tvec4 vertexTangent = vec4(1.0, 0.0, 0.0, 1.0);\r\n#endif\r\n\r\n// =============================================================\r\n//  GPU Instancing\r\n//  When GPU_INSTANCING is defined, per-instance data is provided\r\n//  via vertex attributes at locations 8-13.\r\n// =============================================================\r\n\r\n#ifdef GPU_INSTANCING\r\n\t\tlayout(location = 8)  in vec4 instanceModelRow0;\r\n\t\tlayout(location = 9)  in vec4 instanceModelRow1;\r\n\t\tlayout(location = 10) in vec4 instanceModelRow2;\r\n\t\tlayout(location = 11) in vec4 instanceModelRow3;\r\n\t\tlayout(location = 12) in vec4 instanceColor;\r\n\t\tlayout(location = 13) in vec4 instanceCustomData;\r\n#endif\r\n\r\n// =============================================================\r\n//  Skeletal Animation (Skinning)\r\n// =============================================================\r\n\r\n#ifdef SKINNED\r\n\t#ifdef HAS_BONEINDICES\r\n\t\tlayout (location = 6) in uvec4 vertexBoneIndices;\r\n\t#else\r\n\t\tuvec4 vertexBoneIndices = uvec4(0u, 0u, 0u, 0u);\r\n\t#endif\r\n\r\n\t#ifdef HAS_BONEWEIGHTS\r\n\t\tlayout (location = 7) in vec4 vertexBoneWeights;\r\n\t#else\r\n\t\tvec4 vertexBoneWeights = vec4(0.0, 0.0, 0.0, 0.0);\r\n\t#endif\r\n\r\n\t\tconst int MAX_BONE_INFLUENCE = 4;\r\n\r\n\t\t// Bone matrices stored in a RGBA32F texture - no uniform array size limit.\r\n\t\t// Layout: each bone = 4 consecutive texels (one per column of mat4).\r\n\t\tuniform sampler2D boneMatrixTexture;\r\n\t\tuniform int boneCount;\r\n\r\n\t\tmat4 GetBoneMatrix(int boneIndex)\r\n\t\t{\r\n\t\t\tint texOffset = boneIndex * 4;\r\n            int paletteRow = 0;\r\n#ifdef GPU_INSTANCING\r\n            paletteRow = int(instanceCustomData.x);\r\n#endif\r\n\t\t\tvec4 col0 = texelFetch(boneMatrixTexture, ivec2(texOffset + 0, paletteRow), 0);\r\n\t\t\tvec4 col1 = texelFetch(boneMatrixTexture, ivec2(texOffset + 1, paletteRow), 0);\r\n\t\t\tvec4 col2 = texelFetch(boneMatrixTexture, ivec2(texOffset + 2, paletteRow), 0);\r\n\t\t\tvec4 col3 = texelFetch(boneMatrixTexture, ivec2(texOffset + 3, paletteRow), 0);\r\n\t\t\treturn mat4(col0, col1, col2, col3);\r\n\t\t}\r\n\r\n\t\tvec4 GetSkinnedPosition(vec3 position)\r\n\t\t{\r\n\t\t\tvec4 skinnedPos = vec4(0.0);\r\n\t\t\tfor (int i = 0; i < MAX_BONE_INFLUENCE; i++)\r\n\t\t\t{\r\n\t\t\t\tint boneIndex = int(vertexBoneIndices[i]);\r\n\t\t\t\tfloat weight = vertexBoneWeights[i];\r\n\t\t\t\tif (boneIndex > 0 && weight > 0.0 && boneIndex <= boneCount)\r\n\t\t\t\t{\r\n\t\t\t\t\tmat4 boneTransform = GetBoneMatrix(boneIndex - 1);\r\n\t\t\t\t\tskinnedPos += (boneTransform * vec4(position, 1.0)) * weight;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tfloat totalWeight = vertexBoneWeights.x + vertexBoneWeights.y + vertexBoneWeights.z + vertexBoneWeights.w;\r\n\t\t\tif (totalWeight < 0.01)\r\n\t\t\t\tskinnedPos = vec4(position, 1.0);\r\n\t\t\treturn skinnedPos;\r\n\t\t}\r\n\r\n\t\tvec3 GetSkinnedNormal(vec3 normal)\r\n\t\t{\r\n\t\t\tvec3 skinnedNormal = vec3(0.0);\r\n\t\t\tfor (int i = 0; i < MAX_BONE_INFLUENCE; i++)\r\n\t\t\t{\r\n\t\t\t\tint boneIndex = int(vertexBoneIndices[i]);\r\n\t\t\t\tfloat weight = vertexBoneWeights[i];\r\n\t\t\t\tif (boneIndex > 0 && weight > 0.0 && boneIndex <= boneCount)\r\n\t\t\t\t{\r\n\t\t\t\t\tmat4 boneTransform = GetBoneMatrix(boneIndex - 1);\r\n\t\t\t\t\tskinnedNormal += (mat3(boneTransform) * normal) * weight;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tfloat totalWeight = vertexBoneWeights.x + vertexBoneWeights.y + vertexBoneWeights.z + vertexBoneWeights.w;\r\n\t\t\tif (totalWeight < 0.01)\r\n\t\t\t\tskinnedNormal = normal;\r\n\t\t\treturn normalize(skinnedNormal);\r\n\t\t}\r\n#endif\r\n\r\n// =============================================================\r\n//  Blend Shapes (Morph Targets)\r\n//  Per-mesh delta textures (RGBA32F) hold one \"layer\" per blend-shape frame.\r\n//  Deltas are laid out linearly as idx = layer * morphVertexCount + gl_VertexID\r\n//  and tiled into 2D: (idx % morphTexWidth, idx / morphTexWidth).\r\n//  The renderer uploads only the ACTIVE layers (non-zero weight) into\r\n//  morphWeightTexture, one texel each: (layerIndex, weight, 0, 0).\r\n//  Morphing is applied to the rest-pose vertex BEFORE skinning.\r\n// =============================================================\r\n\r\n\t#ifdef BLENDSHAPES\r\n\t\t\tuniform sampler2D morphPositionTexture;\r\n\t\t\tuniform sampler2D morphNormalTexture;\r\n\t\t\tuniform sampler2D morphTangentTexture;\r\n\t\t\tuniform sampler2D morphWeightTexture;\r\n\t\t\tuniform int morphActiveCount;\r\n\t\t\tuniform int morphTexWidth;\r\n\t\t\tuniform int morphVertexCount;\r\n\t\t\tuniform int morphHasNormals;\r\n\t\t\tuniform int morphHasTangents;\r\n\r\n\t\t\t//   N7   under GPU_INSTANCING the weight texture becomes a per-instance palette:\r\n\t\t\t// each instance's row (instanceCustomData.y) holds its active (layer, weight)\r\n\t\t\t// texels, and instanceCustomData.z its active count.\r\n\t\t#ifdef GPU_INSTANCING\r\n\t\t\t#define MORPH_WEIGHT_ROW int(instanceCustomData.y)\r\n\t\t\t#define MORPH_ACTIVE_COUNT int(instanceCustomData.z)\r\n\t\t#else\r\n\t\t\t#define MORPH_WEIGHT_ROW 0\r\n\t\t\t#define MORPH_ACTIVE_COUNT morphActiveCount\r\n\t\t#endif\r\n\r\n\t\t\tvec3 SampleMorphDelta(sampler2D tex, int layer)\r\n\t\t\t{\r\n\t\t\t\tint idx = layer * morphVertexCount + gl_VertexID;\r\n\t\t\t\treturn texelFetch(tex, ivec2(idx % morphTexWidth, idx / morphTexWidth), 0).xyz;\r\n\t\t\t}\r\n\r\n\t\t\tvec3 GetMorphedPosition(vec3 position)\r\n\t\t\t{\r\n\t\t\t\tfor (int i = 0; i < MORPH_ACTIVE_COUNT; i++)\r\n\t\t\t\t{\r\n\t\t\t\t\tvec2 lw = texelFetch(morphWeightTexture, ivec2(i, MORPH_WEIGHT_ROW), 0).xy;\r\n\t\t\t\t\tposition += SampleMorphDelta(morphPositionTexture, int(lw.x)) * lw.y;\r\n\t\t\t\t}\r\n\t\t\t\treturn position;\r\n\t\t\t}\r\n\r\n\t\t\tvec3 GetMorphedNormal(vec3 normal)\r\n\t\t\t{\r\n\t\t\t\tif (morphHasNormals == 0) return normal;\r\n\t\t\t\tfor (int i = 0; i < MORPH_ACTIVE_COUNT; i++)\r\n\t\t\t\t{\r\n\t\t\t\t\tvec2 lw = texelFetch(morphWeightTexture, ivec2(i, MORPH_WEIGHT_ROW), 0).xy;\r\n\t\t\t\t\tnormal += SampleMorphDelta(morphNormalTexture, int(lw.x)) * lw.y;\r\n\t\t\t\t}\r\n\t\t\t\treturn normal;\r\n\t\t\t}\r\n\r\n\t\t\tvec3 GetMorphedTangent(vec3 tangent)\r\n\t\t\t{\r\n\t\t\t\tif (morphHasTangents == 0) return tangent;\r\n\t\t\t\tfor (int i = 0; i < MORPH_ACTIVE_COUNT; i++)\r\n\t\t\t\t{\r\n\t\t\t\t\tvec2 lw = texelFetch(morphWeightTexture, ivec2(i, MORPH_WEIGHT_ROW), 0).xy;\r\n\t\t\t\t\ttangent += SampleMorphDelta(morphTangentTexture, int(lw.x)) * lw.y;\r\n\t\t\t\t}\r\n\t\t\t\treturn tangent;\r\n\t\t\t}\r\n#else\r\n\t\t// No-op passthroughs so shaders can call these unconditionally.\r\n\t\tvec3 GetMorphedPosition(vec3 position) { return position; }\r\n\t\tvec3 GetMorphedNormal(vec3 normal) { return normal; }\r\n\t\tvec3 GetMorphedTangent(vec3 tangent) { return tangent; }\r\n#endif\r\n\r\n// =============================================================\r\n//  Vertex Utilities\r\n//  Helper functions that handle instancing + skinning so shaders\r\n//  don't need to repeat the same boilerplate.\r\n//\r\n//  Usage:\r\n//    mat4 modelMatrix = GetModelMatrix();\r\n//    mat4 mvpMatrix = GetMVPMatrix();\r\n//    vec4 worldPos = TransformPosition(vertexPosition);          // handles skinning + instancing\r\n//    vec3 worldNrm = TransformNormal(vertexNormal);              // handles skinning + instancing\r\n//    vec3 worldTan = TransformNormal(vertexTangent.xyz);         // works for tangents too\r\n//    vec4 clipPos  = TransformClip(vertexPosition);              // MVP-transformed\r\n//    vec4 vColor   = GetVertexColor();                           // applies instance tint\r\n// =============================================================\r\n\r\n// Returns the model (object-to-world) matrix, accounting for GPU instancing.\r\nmat4 GetModelMatrix()\r\n{\r\n#ifdef GPU_INSTANCING\r\n\treturn mat4(instanceModelRow0, instanceModelRow1, instanceModelRow2, instanceModelRow3);\r\n#else\r\n\treturn XENGINE_MATRIX_M;\r\n#endif\r\n}\r\n\r\n// Returns the Model-View-Projection matrix, accounting for GPU instancing.\r\nmat4 GetMVPMatrix()\r\n{\r\n#ifdef GPU_INSTANCING\r\n\treturn XENGINE_MATRIX_VP * GetModelMatrix();\r\n#else\r\n\treturn XENGINE_MATRIX_MVP;\r\n#endif\r\n}\r\n\r\n// Transform a position to world space (applies morph, then skinning if active, then model matrix).\r\nvec3 TransformPosition(vec3 position)\r\n{\r\n\tposition = GetMorphedPosition(position);\r\n\tmat4 model = GetModelMatrix();\r\n#ifdef SKINNED\r\n\treturn (model * GetSkinnedPosition(position)).xyz;\r\n#else\r\n\treturn (model * vec4(position, 1.0)).xyz;\r\n#endif\r\n}\r\n\r\n// Transform a position to clip space (applies morph, then skinning if active, then MVP matrix).\r\nvec4 TransformClip(vec3 position)\r\n{\r\n\tposition = GetMorphedPosition(position);\r\n\tmat4 mvp = GetMVPMatrix();\r\n#ifdef SKINNED\r\n\treturn mvp * GetSkinnedPosition(position);\r\n#else\r\n\treturn mvp * vec4(position, 1.0);\r\n#endif\r\n}\r\n\r\n// Transform a direction/normal to world space (applies skinning if active, then model rotation).\r\nvec3 TransformDirection(vec3 dir)\r\n{\r\n\tmat4 model = GetModelMatrix();\r\n#ifdef SKINNED\r\n\treturn normalize(mat3(model) * GetSkinnedNormal(dir));\r\n#else\r\n\treturn normalize(mat3(model) * dir);\r\n#endif\r\n}\r\n\r\n// Get vertex color with per-instance tint applied.\r\nvec4 GetInstanceColor()\r\n{\r\n#ifdef GPU_INSTANCING\r\n\treturn vertexColor * instanceColor;\r\n#else\r\n\treturn vertexColor;\r\n#endif\r\n}\r\n\r\n// Get per-instance custom data (available only with GPU instancing).\r\nvec4 GetInstanceCustomData()\r\n{\r\n#ifdef GPU_INSTANCING\r\n\treturn instanceCustomData;\r\n#else\r\n\treturn vec4(0.0);\r\n#endif\r\n}\r\n\r\n#endif\r\n\n\n            out vec3 vDirection;\n\n            void main()\n            {\n                gl_Position = TransformSkyboxClip(vertexPosition);\n                vDirection = vertexPosition;\n            }",
            "_fragmentSource": "\n#ifndef XENGINE_CG\r\n#define XENGINE_CG\r\n\n#ifndef SHADER_SHADERVARIABLES\r\n#define SHADER_SHADERVARIABLES\r\n\r\n// Global Uniform Buffer containing per-frame shared rendering data\r\n// Uses std140 layout for compatibility across all GPUs\r\n// This data is uploaded once per frame and is constant across all draw calls\r\n// Note: binding qualifier requires GLSL 420+, otherwise binding is set via glUniformBlockBinding in C# code\r\n#if __VERSION__ >= 420\r\nlayout(std140, binding = 0) uniform GlobalUniforms\r\n#else\r\nlayout(std140) uniform GlobalUniforms\r\n#endif\r\n{\r\n    // Camera matrices\r\n    mat4 xengine_MatV;\r\n    mat4 xengine_MatIV;\r\n    mat4 xengine_MatP;\r\n    mat4 xengine_MatVP;\r\n    mat4 xengine_PrevViewProj;\r\n    mat4 xengine_MatIP;\r\n    mat4 xengine_MatIVP;\r\n    mat4 xengine_MatVP_NonJittered;\r\n\r\n    // Camera parameters\r\n    vec3 _WorldSpaceCameraPos;\r\n    float _padding0;\r\n\r\n    vec4 _ProjectionParams;\r\n    vec4 _ScreenParams;\r\n    vec2 _CameraJitter;\r\n    vec2 _CameraPreviousJitter;\r\n\r\n    // Time parameters\r\n    vec4 _Time;\r\n    vec4 _SinTime;\r\n    vec4 _CosTime;\r\n    vec4 xengine_DeltaTime;\r\n};\r\n\r\n// Per-object uniforms (set per draw call)\r\nuniform mat4 xengine_ObjectToWorld;\r\nuniform mat4 xengine_WorldToObject;\r\nuniform mat4 xengine_PrevObjectToWorld;\r\nuniform int _ObjectID;\r\nuniform int _RenderingLayerMask;\r\n\r\n#define XENGINE_MATRIX_V xengine_MatV\r\n#define XENGINE_MATRIX_VP_PREVIOUS xengine_PrevViewProj\r\n#define XENGINE_MATRIX_I_V xengine_MatIV\r\n#define XENGINE_MATRIX_P xengine_MatP\r\n#define XENGINE_MATRIX_VP xengine_MatVP\r\n#define XENGINE_MATRIX_I_P xengine_MatIP\r\n#define XENGINE_MATRIX_I_VP xengine_MatIVP\r\n#define XENGINE_MATRIX_VP_NONJITTERED xengine_MatVP_NonJittered\r\n#define XENGINE_MATRIX_M xengine_ObjectToWorld\r\n#define XENGINE_MATRIX_M_PREVIOUS xengine_PrevObjectToWorld\r\n\r\n// Derived matrices\r\nmat4 xengine_MatMV = xengine_MatV * xengine_ObjectToWorld;\r\nmat4 xengine_MatMVP = xengine_MatVP * xengine_ObjectToWorld;\r\nmat4 xengine_MatTMV = transpose(xengine_MatV * xengine_ObjectToWorld);\r\nmat4 xengine_MatITMV = transpose(xengine_WorldToObject * xengine_MatIV);\r\n\r\n#define XENGINE_MATRIX_MV xengine_MatMV\r\n#define XENGINE_MATRIX_MVP xengine_MatMVP\r\n#define XENGINE_MATRIX_T_MV xengine_MatTMV\r\n#define XENGINE_MATRIX_IT_MV xengine_MatITMV\r\n\r\n#endif\n\n#define XENGINE_PI            3.14159265359\r\n#define XENGINE_TWO_PI        6.28318530718\r\n#define XENGINE_FOUR_PI       12.56637061436\r\n#define XENGINE_INV_PI        0.31830988618\r\n#define XENGINE_INV_TWO_PI    0.15915494309\r\n#define XENGINE_INV_FOUR_PI   0.07957747155\r\n#define XENGINE_HALF_PI       1.57079632679\r\n#define XENGINE_INV_HALF_PI   0.636619772367\r\n\r\n// Colors ===========================================================\r\n// http://chilliant.blogspot.com.au/2012/08/srgb-approximations-for-hlsl.html?m=1\r\nvec3 linearToGammaSpace(vec3 lin)\r\n{\r\n    return max(1.055 * pow(max(lin, vec3(0.0)), vec3(0.416666667)) - 0.055, 0.0);\r\n}\r\n\r\n// http://chilliant.blogspot.com.au/2012/08/srgb-approximations-for-hlsl.html?m=1\r\nvec3 gammaToLinearSpace(vec3 gamma)\r\n{\r\n    return gamma * (gamma * (gamma * 0.305306011 + 0.682171111) + 0.012522878);\r\n}\r\n\r\n// Decode only authored color RGB stored in a non-sRGB texture. Hardware-sRGB and\r\n// linear/HDR samples pass through exactly; alpha and data textures never enter here.\r\nvec3 DecodeColorTexture(vec3 sampleColor, float srgbDecode)\r\n{\r\n    if (srgbDecode <= 0.0) return sampleColor;\r\n    vec3 low = sampleColor / 12.92;\r\n    vec3 high = pow(max((sampleColor + 0.055) / 1.055, vec3(0.0)), vec3(2.4));\r\n    return mix(high, low, lessThanEqual(sampleColor, vec3(0.04045)));\r\n}\r\n// ============================================================================\r\n\r\nfloat linearizeDepth(float depth, float near, float far) \r\n{\r\n    float z = depth * 2.0 - 1.0; // Back to NDC [-1,1] range\r\n    return (2.0 * near * far) / (far + near - z * (far - near));\r\n}\r\n\r\nfloat linearizeDepthFromProjection(float depth) {\r\n    return linearizeDepth(depth, _ProjectionParams.y, _ProjectionParams.z);\r\n}\r\n\r\nfloat getFovFromProjectionMatrix(mat4 proj)\r\n{\r\n    // proj[1][1] is M11, the Y scale\r\n    // FOV = 2 * atan(1/M11)\r\n    return 2.0 * atan(1.0 / proj[1][1]);\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n\r\nvec3 projectAndDivide(mat4 matrix, vec3 pos) {\r\n    vec4 p = matrix * vec4(pos, 1.0);\r\n    return p.xyz / p.w;\r\n}\r\n\r\nvec3 getScreenPos(vec2 tc, sampler2D depthSampler) {\r\n\treturn vec3(tc, texture(depthSampler, tc).x);\r\n}\r\nvec3 getScreenPos(vec2 tc, float depth) {\r\n\treturn vec3(tc, depth);\r\n}\r\n\r\nvec3 getScreenFromViewPos(vec3 viewPos) {\r\n\tvec3 p = projectAndDivide(XENGINE_MATRIX_P, viewPos);\r\n\treturn p * 0.5 + 0.5;\r\n}\r\n\r\nvec3 getNDCFromScreenPos(vec3 screenPos) {\r\n\treturn screenPos * 2.0 - 1.0;\r\n}\r\n\r\nvec3 getViewFromScreenPos(vec3 screenPos) {\r\n\treturn projectAndDivide(XENGINE_MATRIX_I_P, getNDCFromScreenPos(screenPos));\r\n}\r\n\r\nvec3 getViewPos(vec2 tc, sampler2D depthSampler) {\r\n\treturn getViewFromScreenPos(getScreenPos(tc, depthSampler));\r\n}\r\nvec3 getViewPos(vec2 tc, float depth) {\r\n\treturn getViewFromScreenPos(getScreenPos(tc, depth));\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n// Math Utilities\r\n\r\n#define saturate(x) clamp(x, 0.0, 1.0)\r\n#define rcp(x) (1.0 / (x))\r\n#define max0(x) max(x, 0.0)\r\n\r\n// Min/Max of vector components\r\nfloat minOf(vec2 v) { return min(v.x, v.y); }\r\nfloat minOf(vec3 v) { return min(v.x, min(v.y, v.z)); }\r\nfloat minOf(vec4 v) { return min(v.x, min(v.y, min(v.z, v.w))); }\r\nfloat maxOf(vec2 v) { return max(v.x, v.y); }\r\nfloat maxOf(vec3 v) { return max(v.x, max(v.y, v.z)); }\r\nfloat maxOf(vec4 v) { return max(v.x, max(v.y, max(v.z, v.w))); }\r\n\r\n// Squared dot product\r\nfloat sdot(vec2 x) { return dot(x, x); }\r\nfloat sdot(vec3 x) { return dot(x, x); }\r\nfloat sdot(vec4 x) { return dot(x, x); }\r\n\r\n// Square function\r\nfloat sqr(float x) { return x * x; }\r\nvec2 sqr(vec2 x) { return x * x; }\r\nvec3 sqr(vec3 x) { return x * x; }\r\nvec4 sqr(vec4 x) { return x * x; }\r\n\r\n// Linear step with saturation\r\nfloat linearstep(float a, float b, float x) {\r\n\treturn saturate((x - a) / (b - a));\r\n}\r\n\r\n// Fast approximations for trigonometric functions\r\nfloat fastSign(float x) {\r\n\treturn x >= 0.0 ? 1.0 : -1.0;\r\n}\r\n\r\n// Fast acos approximation using polynomial\r\nfloat fastAcos(float x) {\r\n\tfloat y = abs(x);\r\n\tfloat p = -0.0187293 * y + 0.0742610;\r\n\tp = p * y - 0.2121144;\r\n\tp = p * y + 1.5707288;\r\n\tp = p * sqrt(1.0 - y);\r\n\treturn x >= 0.0 ? p : XENGINE_PI - p;\r\n}\r\n\r\n// Extract diagonal from matrix\r\nvec2 diagonal2(mat4 m) { return vec2(m[0].x, m[1].y); }\r\nvec3 diagonal3(mat4 m) { return vec3(m[0].x, m[1].y, m[2].z); }\r\n\r\n// Trigonometric utilities\r\nvec2 cossin(float x) { return vec2(cos(x), sin(x)); }\r\n\r\n// ----------------------------------------------------------------------------\r\n// Color Utilities\r\n\r\n// Luminance calculation (Rec. 709 coefficients)\r\nfloat luminance(vec3 color) {\r\n\treturn dot(color, vec3(0.2126, 0.7152, 0.0722));\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n// Random Number Generation\r\n\r\nuint triple32(uint x) {\r\n\t// https://nullprogram.com/blog/2018/07/31/\r\n\tx ^= x >> 17;\r\n\tx *= 0xed5ad4bbu;\r\n\tx ^= x >> 11;\r\n\tx *= 0xac4c1b51u;\r\n\tx ^= x >> 15;\r\n\tx *= 0x31848babu;\r\n\tx ^= x >> 14;\r\n\treturn uint(x);\r\n}\r\n\r\nstruct NoiseGenerator {\r\n\tuint currentNum;\r\n};\r\n\r\nNoiseGenerator createNoiseGenerator(vec4 glFragCoord) {\r\n    // Create seed from pixel coordinates\r\n    uint x = uint(glFragCoord.x);\r\n    uint y = uint(glFragCoord.y);\r\n    uint seed = triple32(x + y * uint(_ScreenParams.x));\r\n\treturn NoiseGenerator(seed);\r\n}\r\n\r\nNoiseGenerator createNoiseGenerator(vec4 glFragCoord, uint frameIndex) {\r\n    // Create seed from pixel coordinates + frame index for temporal variation\r\n    uint x = uint(glFragCoord.x);\r\n    uint y = uint(glFragCoord.y);\r\n    uint seed = triple32(x + y * uint(_ScreenParams.x) + frameIndex * 1973u);\r\n\treturn NoiseGenerator(seed);\r\n}\r\n\r\nuint randNext(inout NoiseGenerator gen)\r\n{\r\n    gen.currentNum = triple32(gen.currentNum);\r\n    return gen.currentNum;\r\n}\r\n\r\nuvec2 randNext2(inout NoiseGenerator gen) { return uvec2(randNext(gen), randNext(gen)); }\r\nuvec3 randNext3(inout NoiseGenerator gen) { return uvec3(randNext2(gen), randNext(gen)); }\r\nuvec4 randNext4(inout NoiseGenerator gen) { return uvec4(randNext3(gen), randNext(gen)); }\r\n\r\nfloat randNextF(inout NoiseGenerator gen) { return float(randNext(gen)) / float(0xffffffffu); }\r\nvec2 randNext2F(inout NoiseGenerator gen) { return vec2(randNext2(gen)) / float(0xffffffffu); }\r\nvec3 randNext3F(inout NoiseGenerator gen) { return vec3(randNext3(gen)) / float(0xffffffffu); }\r\nvec4 randNext4F(inout NoiseGenerator gen) { return vec4(randNext4(gen)) / float(0xffffffffu); } \r\n\r\n// Simple hash-based random for per-pixel variation\r\nfloat hash1(vec2 p) {\r\n\tvec3 p3 = fract(vec3(p.xyx) * 443.897);\r\n\tp3 += dot(p3, p3.zyx + 19.19);\r\n\treturn fract((p3.x + p3.y) * p3.z);\r\n}\r\n\r\nvec2 hash2(vec2 p) {\r\n\tvec3 p3 = fract(vec3(p.xyx) * vec3(443.897, 441.423, 437.195));\r\n\tp3 += dot(p3, p3.yzx + 19.19);\r\n\treturn fract((p3.xx + p3.yz) * p3.zy);\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n// Sampling Utilities\r\n\r\n// Sample cosine-weighted hemisphere around a normal\r\nvec3 SampleCosineHemisphere(vec3 normal, vec2 xy) {\r\n\tfloat phi = XENGINE_TWO_PI * xy.x;\r\n\tfloat cosTheta = xy.y * 2.0 - 1.0;\r\n\tfloat sinTheta = sqrt(saturate(1.0 - cosTheta * cosTheta));\r\n\tvec3 hemisphere = vec3(cossin(phi) * sinTheta, cosTheta);\r\n\r\n\tvec3 cosineVector = normalize(normal + hemisphere);\r\n\treturn cosineVector * fastSign(dot(cosineVector, normal));\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n// Depth Utilities\r\n\r\n// Convert screen-space depth to view-space depth\r\nfloat ScreenToViewDepth(float depth) {\r\n\tfloat z = depth * 2.0 - 1.0; // Back to NDC\r\n\treturn -XENGINE_MATRIX_P[3].z / (XENGINE_MATRIX_P[2].z + z);\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n// Reprojection Utilities\r\n\r\n// Reproject current screen position to previous frame using motion\r\nvec3 Reproject(vec2 screenUV, float depth, mat4 prevViewProj) {\r\n\t// Get current view space position\r\n\tvec3 viewPos = getViewPos(screenUV, depth);\r\n\r\n\t// Transform to world space\r\n\tvec4 worldPos = XENGINE_MATRIX_I_V * vec4(viewPos, 1.0);\r\n\r\n\t// Transform to previous frame's clip space\r\n\tvec4 prevClip = prevViewProj * worldPos;\r\n\r\n\t// Perspective divide\r\n\tvec3 prevNDC = prevClip.xyz / prevClip.w;\r\n\r\n\t// Convert to screen space [0,1]\r\n\tvec3 prevScreen = prevNDC * 0.5 + 0.5;\r\n\r\n\treturn prevScreen;\r\n}\r\n\r\n// Check if reprojection is valid (no disocclusion)\r\nbool IsReprojectionValid(vec2 prevUV, float currentDepth, float prevDepth, vec3 currentNormal, vec3 prevNormal) {\r\n\t// Out of screen\r\n\tif (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0)\r\n\t\treturn false;\r\n\r\n\t// Depth discontinuity check\r\n\tfloat depthDiff = abs(currentDepth - prevDepth);\r\n\tif (depthDiff > 0.01)\r\n\t\treturn false;\r\n\r\n\t// Normal discontinuity check\r\n\tfloat normalDot = dot(currentNormal, prevNormal);\r\n\tif (normalDot < 0.9)\r\n\t\treturn false;\r\n\r\n\treturn true;\r\n}\r\n\r\n// Normal Mapping ===========================================================\r\n\r\n// Apply a tangent-space normal map to a world-space normal.\r\n// If tangents are available (HAS_TANGENTS), constructs a TBN matrix and transforms\r\n// the sampled normal. Otherwise returns the interpolated world normal as-is.\r\n//\r\n// Usage:\r\n//   vec3 worldNormal = ApplyNormalMap(normalTex, uv, vNormal, vTangent, vBitangent);\r\n//\r\n// For shaders without normal maps, just use normalize(vNormal) directly.\r\nvec3 ApplyNormalMap(sampler2D normalTex, vec2 uv, vec3 normal, vec3 tangent, vec3 bitangent)\r\n{\r\n#ifdef HAS_TANGENTS\r\n    mat3 TBN = mat3(normalize(tangent), normalize(bitangent), normalize(normal));\r\n    vec3 normalTS = texture(normalTex, uv).rgb * 2.0 - 1.0;\r\n    return normalize(TBN * normalTS);\r\n#else\r\n    return normalize(normal);\r\n#endif\r\n}\r\n\r\n// Encode a world-space normal to view-space [0,1] range for the depth-normals pre-pass.\r\nvec4 EncodeViewNormal(vec3 worldNormal)\r\n{\r\n    vec3 viewNormal = normalize(mat3(XENGINE_MATRIX_V) * worldNormal);\r\n    return vec4(viewNormal * 0.5 + 0.5, float(_RenderingLayerMask) / 255.0);\r\n}\r\n\r\nvec3 DecodeViewNormal(vec4 encoded)\r\n{\r\n    vec3 viewNormal = encoded.xyz * 2.0 - 1.0;\r\n    return normalize(mat3(XENGINE_MATRIX_I_V) * viewNormal);\r\n}\r\n\r\n// Camera-centered sky dome: drop view translation so the mesh is not a world-space sphere.\r\n// Perspective already fills the far plane. Ortho maps a unit dome to a tiny NDC circle\r\n// (P scales by 2/orthoSize). Scale XY well past the NDC corners so a coarse sphere\r\n// tessellation still covers the rectangle (mesh radius ~0.95, inscribed-polygon chords).\r\nvec4 TransformSkyboxClip(vec3 objectPos)\r\n{\r\n    vec3 viewDir = mat3(XENGINE_MATRIX_V) * objectPos;\r\n    vec4 clip = XENGINE_MATRIX_P * vec4(viewDir, 1.0);\r\n    vec4 origin = XENGINE_MATRIX_P * vec4(0.0, 0.0, 0.0, 1.0);\r\n    if (abs(origin.w) > 0.5)\r\n    {\r\n        clip.x = viewDir.x * 4.0 * origin.w;\r\n        clip.y = viewDir.y * 4.0 * origin.w;\r\n    }\r\n    clip.z = clip.w;\r\n    // Ortho flattens the dome along view Z, so with ZTest Off the behind-camera hemisphere\r\n    // lands on the same pixels as the sky and submission order decides each pixel.\r\n    // Perspective is safe (w = -viewZ hardware-clips it); here push those verts past the\r\n    // far plane so the clipper removes them.\r\n    if (abs(origin.w) > 0.5 && viewDir.z > 0.0)\r\n        clip.z = 2.0 * abs(clip.w) + 1.0;\r\n    return clip;\r\n}\r\n\r\n// ----------------------------------------------------------------------------\r\n\r\n\r\n#endif\r\n\n\n            layout (location = 0) out vec4 fragColor;\n\n            in vec3 vDirection;\n\n            uniform sampler2D _MainTex;\n\n            void main()\n            {\n                vec3 direction = normalize(vDirection);\n                \n                float u = atan(direction.z, direction.x) * 0.15915494 + 0.5;\n                float v = asin(clamp(direction.y, -1.0, 1.0)) * 0.31830989 + 0.5;\n                vec3 color = texture(_MainTex, vec2(u, v)).rgb;\n                fragColor = vec4(color, 1.0);\n            }",
            "_hlslVertexSource": "\n#ifndef XENGINE_CG_HLSL\r\n#define XENGINE_CG_HLSL\r\n\r\n// Match hardware sRGB sampling before applying linear tints. Keep linear HDR\r\n// (including negative components) untouched and decode neither alpha nor data.\r\nfloat3 DecodeColorTexture(float3 sampleColor, float srgbDecode)\r\n{\r\n    if (srgbDecode <= 0.0) return sampleColor;\r\n    float3 low = sampleColor / 12.92;\r\n    float3 high = pow(max((sampleColor + 0.055) / 1.055, 0.0.xxx), 2.4.xxx);\r\n    return float3(sampleColor.r <= 0.04045 ? low.r : high.r,\r\n                  sampleColor.g <= 0.04045 ? low.g : high.g,\r\n                  sampleColor.b <= 0.04045 ? low.b : high.b);\r\n}\r\n\r\n// Minimal HLSL counterpart of ShaderVariables / XEngineCG for dual-backend shaders.\r\n// Layout mirrors the GLSL GlobalUniforms UBO where practical.\r\n\r\ncbuffer GlobalUniforms : register(b0)\r\n{\r\n    float4x4 xengine_MatV;\r\n    float4x4 xengine_MatIV;\r\n    float4x4 xengine_MatP;\r\n    float4x4 xengine_MatVP;\r\n    float4x4 xengine_PrevViewProj;\r\n    float4x4 xengine_MatIP;\r\n    float4x4 xengine_MatIVP;\r\n    float4x4 xengine_MatVP_NonJittered;\r\n\r\n    float3 _WorldSpaceCameraPos;\r\n#if defined(XENGINE_METAL)\r\n    // Metal gives float3 a full 16-byte slot. Keep the following block aligned with\r\n    // GlobalUniformsData by reserving a full register here; the Metal uploader inserts it.\r\n    float4 _padding0;\r\n#else\r\n    float _padding0;\r\n#endif\r\n\r\n    float4 _ProjectionParams;\r\n    float4 _ScreenParams;\r\n    float2 _CameraJitter;\r\n    float2 _CameraPreviousJitter;\r\n\r\n    float4 _Time;\r\n    float4 _SinTime;\r\n    float4 _CosTime;\r\n    float4 xengine_DeltaTime;\r\n};\r\n\r\ncbuffer ObjectUniforms : register(b1)\r\n{\r\n    float4x4 xengine_ObjectToWorld;\r\n    float4x4 xengine_WorldToObject;\r\n    float4x4 xengine_PrevObjectToWorld;\r\n    int _ObjectID;\r\n    // Per-object baked-GI state (CalculateGI in StandardSurface / StandardLighting). _GIMode selects\r\n    // realtime-ambient (0) / baked lightmap (1) / light-probe SH (2). _LightmapUV picks the UV set\r\n    // the lightmap was baked into (1 = UV2, 0 = UV0 fallback).\r\n    int _GIMode;\r\n    int _LightmapUV;\r\n    // 8-bit rendering-layer membership. Default Everything (255) keeps lighting unchanged.\r\n    int _RenderingLayerMask;\r\n    // Per-renderer lightmap UV scale/offset, used when _GIMode == 1.\r\n    float4 _LightmapScaleOffset;\r\n    // Light-probe SH L2 coefficients (the standard 7-vec4 ShadeSH9 packing), used when _GIMode == 2.\r\n    float4 xengine_SHAr;\r\n    float4 xengine_SHAg;\r\n    float4 xengine_SHAb;\r\n    float4 xengine_SHBr;\r\n    float4 xengine_SHBg;\r\n    float4 xengine_SHBb;\r\n    float4 xengine_SHC;\r\n};\r\n\r\n#define XENGINE_MATRIX_V xengine_MatV\r\n#define XENGINE_MATRIX_VP_PREVIOUS xengine_PrevViewProj\r\n#define XENGINE_MATRIX_I_V xengine_MatIV\r\n#define XENGINE_MATRIX_P xengine_MatP\r\n#define XENGINE_MATRIX_VP xengine_MatVP\r\n#define XENGINE_MATRIX_I_P xengine_MatIP\r\n#define XENGINE_MATRIX_I_VP xengine_MatIVP\r\n#define XENGINE_MATRIX_VP_NONJITTERED xengine_MatVP_NonJittered\r\n#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\nstatic float4x4 xengine_InstanceModel;\r\nstatic float4 xengine_InstanceColor;\r\nstatic int xengine_SkinPaletteRow;\r\nstatic int xengine_MorphPaletteRow;\r\nstatic int xengine_MorphActiveCount;\r\n#define XENGINE_INSTANCE_ATTRIBUTES float4 instanceModel0 : TEXCOORD8; float4 instanceModel1 : TEXCOORD9; float4 instanceModel2 : TEXCOORD10; float4 instanceModel3 : TEXCOORD11; float4 instanceColor : TEXCOORD12; float4 instanceCustomData : TEXCOORD13;\r\n#define XENGINE_SETUP_INSTANCE(v) xengine_InstanceModel = transpose(float4x4(v.instanceModel0, v.instanceModel1, v.instanceModel2, v.instanceModel3)); xengine_InstanceColor = v.instanceColor; xengine_SkinPaletteRow = (int)v.instanceCustomData.x; xengine_MorphPaletteRow = (int)v.instanceCustomData.y; xengine_MorphActiveCount = (int)v.instanceCustomData.z\r\n#define XENGINE_MATRIX_M xengine_InstanceModel\r\n#else\r\n#define XENGINE_INSTANCE_ATTRIBUTES\r\n#define XENGINE_SETUP_INSTANCE(v)\r\n#define XENGINE_MATRIX_M xengine_ObjectToWorld\r\n#endif\r\n#define XENGINE_MATRIX_M_PREVIOUS xengine_PrevObjectToWorld\r\n\r\nfloat4x4 GetModelMatrix() { return XENGINE_MATRIX_M; }\r\n\r\n// =============================================================\r\n//  Skeletal Animation (Skinning)   clean-base reimplementation.\r\n//  Lesson from the failed first attempt (skinning-wip branch): the path was\r\n//  built and debugged on top of THREE stacked breakages, so no probe result\r\n//  was ever trustworthy. This version differs in one decisive way: boneCount\r\n//  is a compile-time constant (XENGINE_SKIN_BONE_COUNT) instead of a cbuffer  \r\n//  the old dedicated cbuffer(b10) had no binder and read 0, collapsing every\r\n//  weighted vertex. Texture slot is t15, the only slot no other shader claims\r\n//  (Standard materials t0-t3/t9/t10, lighting t4-t8/t11/t14, Toon spec t12,\r\n//  light cookie atlas t13). Bound BY NAME from SkinnedMeshRenderer.\r\n// =============================================================\r\n#ifdef SKINNED\r\n\r\nTexture2D<float4> boneMatrixTexture : register(t15);\r\n#define XENGINE_SKIN_BONE_COUNT 512\r\n\r\nstatic const int XENGINE_MAX_BONE_INFLUENCE = 4;\r\n\r\nfloat4x4 XSkinGetBoneMatrix(int boneIndex)\r\n{\r\n    // C# Float4x4 stores columns consecutively (c0..c3, one texel each), while Slang matrix\r\n    // initializers consume rows regardless of the selected uniform-memory layout. Fold the four\r\n    // uploaded columns into rows so mul(matrix, columnVector) matches the CPU transform exactly.\r\n    int t = boneIndex * 4;\r\n    int row = 0;\r\n#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\n    row = xengine_SkinPaletteRow;\r\n#endif\r\n    float4 c0 = boneMatrixTexture.Load(int3(t + 0, row, 0));\r\n    float4 c1 = boneMatrixTexture.Load(int3(t + 1, row, 0));\r\n    float4 c2 = boneMatrixTexture.Load(int3(t + 2, row, 0));\r\n    float4 c3 = boneMatrixTexture.Load(int3(t + 3, row, 0));\r\n    return float4x4(\r\n        float4(c0.x, c1.x, c2.x, c3.x),\r\n        float4(c0.y, c1.y, c2.y, c3.y),\r\n        float4(c0.z, c1.z, c2.z, c3.z),\r\n        float4(c0.w, c1.w, c2.w, c3.w));\r\n}\r\n\r\nfloat4 XSkinPosition(float3 position, uint4 boneIdx, float4 boneWgt)\r\n{\r\n    float4 skinned = float4(0.0, 0.0, 0.0, 0.0);\r\n    [unroll]\r\n    for (int i = 0; i < XENGINE_MAX_BONE_INFLUENCE; i++)\r\n    {\r\n        int boneIndex = (int)boneIdx[i];\r\n        float weight = boneWgt[i];\r\n        if (boneIndex > 0 && weight > 0.0 && boneIndex <= XENGINE_SKIN_BONE_COUNT)\r\n            skinned += mul(XSkinGetBoneMatrix(boneIndex - 1), float4(position, 1.0)) * weight;\r\n    }\r\n    if (boneWgt.x + boneWgt.y + boneWgt.z + boneWgt.w < 0.01)\r\n        skinned = float4(position, 1.0);\r\n    return skinned;\r\n}\r\n\r\nfloat3 XSkinNormal(float3 normal, uint4 boneIdx, float4 boneWgt)\r\n{\r\n    float3 skinned = float3(0.0, 0.0, 0.0);\r\n    [unroll]\r\n    for (int i = 0; i < XENGINE_MAX_BONE_INFLUENCE; i++)\r\n    {\r\n        int boneIndex = (int)boneIdx[i];\r\n        float weight = boneWgt[i];\r\n        if (boneIndex > 0 && weight > 0.0 && boneIndex <= XENGINE_SKIN_BONE_COUNT)\r\n            skinned += mul((float3x3)XSkinGetBoneMatrix(boneIndex - 1), normal) * weight;\r\n    }\r\n    return skinned;\r\n}\r\n\r\nfloat4 TransformClipSkinned(float3 objectPos, uint4 boneIdx, float4 boneWgt)\r\n{\r\n    return mul(XENGINE_MATRIX_VP, mul(XENGINE_MATRIX_M, XSkinPosition(objectPos, boneIdx, boneWgt)));\r\n}\r\n\r\nfloat3 TransformPositionSkinned(float3 objectPos, uint4 boneIdx, float4 boneWgt)\r\n{\r\n    return mul(XENGINE_MATRIX_M, XSkinPosition(objectPos, boneIdx, boneWgt)).xyz;\r\n}\r\n\r\n#endif // SKINNED\r\n\r\nfloat4 TransformClip(float3 objectPos)\r\n{\r\n    return mul(XENGINE_MATRIX_VP, mul(XENGINE_MATRIX_M, float4(objectPos, 1.0)));\r\n}\r\n\r\nfloat3 TransformPosition(float3 objectPos)\r\n{\r\n    return mul(XENGINE_MATRIX_M, float4(objectPos, 1.0)).xyz;\r\n}\r\n\r\nfloat3 TransformDirection(float3 dir)\r\n{\r\n    return normalize(mul((float3x3)XENGINE_MATRIX_M, dir));\r\n}\r\n\r\n// Camera-centered sky dome: drop view translation so the mesh is not a world-space sphere.\r\n// Perspective already fills the far plane. Ortho maps a unit dome to a tiny NDC circle\r\n// (P scales by 2/orthoSize). Scale XY well past the NDC corners so a coarse sphere\r\n// tessellation still covers the rectangle (mesh radius ~0.95, inscribed-polygon chords).\r\nfloat4 TransformSkyboxClip(float3 objectPos)\r\n{\r\n    float3 viewDir = mul((float3x3)XENGINE_MATRIX_V, objectPos);\r\n    float4 clip = mul(XENGINE_MATRIX_P, float4(viewDir, 1.0));\r\n    float4 origin = mul(XENGINE_MATRIX_P, float4(0.0, 0.0, 0.0, 1.0));\r\n    if (abs(origin.w) > 0.5)\r\n    {\r\n        clip.x = viewDir.x * 4.0 * origin.w;\r\n        clip.y = viewDir.y * 4.0 * origin.w;\r\n    }\r\n    clip.z = clip.w;\r\n    // Ortho flattens the dome along view Z, so with ZTest Off the behind-camera hemisphere\r\n    // lands on the same pixels as the sky and submission order decides each pixel.\r\n    // Perspective is safe (w = -viewZ hardware-clips it); here push those verts past the\r\n    // far plane so the clipper removes them.\r\n    if (abs(origin.w) > 0.5 && viewDir.z > 0.0)\r\n        clip.z = 2.0 * abs(clip.w) + 1.0;\r\n    return clip;\r\n}\r\n\r\nfloat3 linearToGammaSpace(float3 lin)\r\n{\r\n    return max(1.055 * pow(max(lin, 0.0.xxx), 0.416666667.xxx) - 0.055.xxx, 0.0.xxx);\r\n}\r\n\r\nfloat3 gammaToLinearSpace(float3 gamma)\r\n{\r\n    return gamma * (gamma * (gamma * 0.305306011 + 0.682171111) + 0.012522878);\r\n}\r\n\r\nfloat linearizeDepth(float depth, float nearZ, float farZ)\r\n{\r\n    float z = depth * 2.0 - 1.0;\r\n    return (2.0 * nearZ * farZ) / (farZ + nearZ - z * (farZ - nearZ));\r\n}\r\n\r\nfloat linearizeDepthFromProjection(float depth)\r\n{\r\n    return linearizeDepth(depth, _ProjectionParams.y, _ProjectionParams.z);\r\n}\r\n\r\nfloat4 EncodeViewNormal(float3 worldNormal)\r\n{\r\n    float3 viewN = normalize(mul((float3x3)XENGINE_MATRIX_V, worldNormal));\r\n    return float4(viewN * 0.5 + 0.5, _RenderingLayerMask / 255.0);\r\n}\r\n\r\nfloat3 DecodeViewNormal(float4 encoded)\r\n{\r\n    float3 viewN = encoded.xyz * 2.0 - 1.0;\r\n    return normalize(mul((float3x3)XENGINE_MATRIX_I_V, viewN));\r\n}\r\n\r\nfloat3 ApplyFog(float3 color, float3 worldPos)\r\n{\r\n    // Stub: full fog lives in Lighting.glsl; keep identity until HLSL lighting is ported.\r\n    return color;\r\n}\r\n\r\nfloat4 GetInstanceColor()\r\n{\r\n#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\n    return xengine_InstanceColor;\r\n#else\r\n    return float4(1, 1, 1, 1);\r\n#endif\r\n}\r\n\r\n// =============================================================\r\n//  Blend Shapes (morph targets)   Slang path.\r\n//  Mirrors the GLSL block in VertexAttributes.glsl: per-mesh RGBA32F delta\r\n//  textures hold one \"layer\" per blend-shape frame, laid out linearly as\r\n//  idx = layer * morphVertexCount + vertexID and tiled 2D as\r\n//  (idx % morphTexWidth, idx / morphTexWidth). The renderer uploads only the\r\n//  ACTIVE layers (non-zero weight) into morphWeightTexture, one texel each:\r\n//  (layerIndex, weight, 0, 0). Morphing happens on the rest-pose vertex\r\n//  BEFORE skinning.\r\n//\r\n//  Binding channels (both proven by the skinned path): the four textures ride\r\n//  the per-draw instance texture state by name (like boneMatrixTexture t15),\r\n//  and the five scalars ride the per-draw instance ints, which qualify the\r\n//  draw for a material-block repack   the generic reflection packer fills the\r\n//  MorphParams block declared beneath this comment on every backend that has\r\n//  one (D3D12/WebGPU). Note: avoid the word \"cbuffer\" in this comment   the\r\n//  register scanner's regex captures \"<cbuffer> <identifier>\" even in prose.\r\n//  b7 / t16-t19 are the only slots no other shader claims (b3-b6 = lighting,\r\n//  shadows, reflection probes, light cookies).\r\n// =============================================================\r\n#ifdef BLENDSHAPES\r\n\r\ncbuffer MorphParams : register(b7)\r\n{\r\n\t// No trailing vec3 padding: WGSL gives int3 a 16-byte alignment, which would make this\r\n\t// block 48 bytes there while D3D12 packs it as 32   keep plain scalars so every backend\r\n\t// reflects the same footprint.\r\n\tint morphActiveCount;\r\n\tint morphTexWidth;\r\n\tint morphVertexCount;\r\n\tint morphHasNormals;\r\n\tint morphHasTangents;\r\n};\r\n\r\nTexture2D<float4> morphPositionTexture : register(t16);\r\nTexture2D<float4> morphNormalTexture : register(t17);\r\nTexture2D<float4> morphTangentTexture : register(t18);\r\nTexture2D<float4> morphWeightTexture : register(t19);\r\n\r\nfloat3 XMorphSampleDelta(Texture2D<float4> deltaTex, int layer, uint vertexId)\r\n{\r\n\tint idx = layer * morphVertexCount + (int)vertexId;\r\n\tint2 coord = int2(idx % morphTexWidth, idx / morphTexWidth);\r\n\treturn deltaTex.Load(int3(coord, 0)).xyz;\r\n}\r\n\r\nfloat3 GetMorphedPosition(float3 position, uint vertexId)\r\n{\r\n\t#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\n\tint morphRow = xengine_MorphPaletteRow;\r\n\tint morphCount = xengine_MorphActiveCount;\r\n\t#else\r\n\tint morphRow = 0;\r\n\tint morphCount = morphActiveCount;\r\n\t#endif\r\n\tfor (int i = 0; i < morphCount; i++)\r\n\t{\r\n\t\tfloat2 lw = morphWeightTexture.Load(int3(i, morphRow, 0)).xy;\r\n\t\tposition += XMorphSampleDelta(morphPositionTexture, int(lw.x), vertexId) * lw.y;\r\n\t}\r\n\treturn position;\r\n}\r\n\r\nfloat3 GetMorphedNormal(float3 normal, uint vertexId)\r\n{\r\n\tif (morphHasNormals == 0) return normal;\r\n\t#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\n\tint morphRow = xengine_MorphPaletteRow;\r\n\tint morphCount = xengine_MorphActiveCount;\r\n\t#else\r\n\tint morphRow = 0;\r\n\tint morphCount = morphActiveCount;\r\n\t#endif\r\n\tfor (int i = 0; i < morphCount; i++)\r\n\t{\r\n\t\tfloat2 lw = morphWeightTexture.Load(int3(i, morphRow, 0)).xy;\r\n\t\tnormal += XMorphSampleDelta(morphNormalTexture, int(lw.x), vertexId) * lw.y;\r\n\t}\r\n\treturn normal;\r\n}\r\n\r\nfloat3 GetMorphedTangent(float3 tangent, uint vertexId)\r\n{\r\n\tif (morphHasTangents == 0) return tangent;\r\n\t#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\n\tint morphRow = xengine_MorphPaletteRow;\r\n\tint morphCount = xengine_MorphActiveCount;\r\n\t#else\r\n\tint morphRow = 0;\r\n\tint morphCount = morphActiveCount;\r\n\t#endif\r\n\tfor (int i = 0; i < morphCount; i++)\r\n\t{\r\n\t\tfloat2 lw = morphWeightTexture.Load(int3(i, morphRow, 0)).xy;\r\n\t\ttangent += XMorphSampleDelta(morphTangentTexture, int(lw.x), vertexId) * lw.y;\r\n\t}\r\n\treturn tangent;\r\n}\r\n\r\n#else\r\n\r\n// No-op passthroughs so Slang vertex stages can call these unconditionally\r\n// (GLSL gets the same contract from VertexAttributes.glsl with gl_VertexID implicit).\r\nfloat3 GetMorphedPosition(float3 position, uint vertexId) { return position; }\r\nfloat3 GetMorphedNormal(float3 normal, uint vertexId) { return normal; }\r\nfloat3 GetMorphedTangent(float3 tangent, uint vertexId) { return tangent; }\r\n\r\n#endif\r\n\r\n// One-argument compatibility overloads: game shaders written before morphs reached the Slang\r\n// path (e.g. Zonezero Toon) call these. They cannot fetch deltas (no SV_VertexID in hand), so\r\n// they stay identity   upstream those call sites to the two-argument forms to opt into morphing.\r\nfloat3 GetMorphedPosition(float3 position) { return position; }\r\nfloat3 GetMorphedNormal(float3 normal) { return normal; }\r\nfloat3 GetMorphedTangent(float3 tangent) { return tangent; }\r\n\r\n#endif\r\n\n\n            struct VSInput\n            {\n                float3 vertexPosition : POSITION;\n            };\n\n            struct VSOutput\n            {\n                float4 position : SV_Position;\n                float3 vDirection : TEXCOORD0;\n            };\n\n            VSOutput main(VSInput input)\n            {\n                VSOutput output;\n                output.position = TransformSkyboxClip(input.vertexPosition);\n                output.vDirection = input.vertexPosition;\n                return output;\n            }",
            "_hlslFragmentSource": "\n#ifndef XENGINE_CG_HLSL\r\n#define XENGINE_CG_HLSL\r\n\r\n// Match hardware sRGB sampling before applying linear tints. Keep linear HDR\r\n// (including negative components) untouched and decode neither alpha nor data.\r\nfloat3 DecodeColorTexture(float3 sampleColor, float srgbDecode)\r\n{\r\n    if (srgbDecode <= 0.0) return sampleColor;\r\n    float3 low = sampleColor / 12.92;\r\n    float3 high = pow(max((sampleColor + 0.055) / 1.055, 0.0.xxx), 2.4.xxx);\r\n    return float3(sampleColor.r <= 0.04045 ? low.r : high.r,\r\n                  sampleColor.g <= 0.04045 ? low.g : high.g,\r\n                  sampleColor.b <= 0.04045 ? low.b : high.b);\r\n}\r\n\r\n// Minimal HLSL counterpart of ShaderVariables / XEngineCG for dual-backend shaders.\r\n// Layout mirrors the GLSL GlobalUniforms UBO where practical.\r\n\r\ncbuffer GlobalUniforms : register(b0)\r\n{\r\n    float4x4 xengine_MatV;\r\n    float4x4 xengine_MatIV;\r\n    float4x4 xengine_MatP;\r\n    float4x4 xengine_MatVP;\r\n    float4x4 xengine_PrevViewProj;\r\n    float4x4 xengine_MatIP;\r\n    float4x4 xengine_MatIVP;\r\n    float4x4 xengine_MatVP_NonJittered;\r\n\r\n    float3 _WorldSpaceCameraPos;\r\n#if defined(XENGINE_METAL)\r\n    // Metal gives float3 a full 16-byte slot. Keep the following block aligned with\r\n    // GlobalUniformsData by reserving a full register here; the Metal uploader inserts it.\r\n    float4 _padding0;\r\n#else\r\n    float _padding0;\r\n#endif\r\n\r\n    float4 _ProjectionParams;\r\n    float4 _ScreenParams;\r\n    float2 _CameraJitter;\r\n    float2 _CameraPreviousJitter;\r\n\r\n    float4 _Time;\r\n    float4 _SinTime;\r\n    float4 _CosTime;\r\n    float4 xengine_DeltaTime;\r\n};\r\n\r\ncbuffer ObjectUniforms : register(b1)\r\n{\r\n    float4x4 xengine_ObjectToWorld;\r\n    float4x4 xengine_WorldToObject;\r\n    float4x4 xengine_PrevObjectToWorld;\r\n    int _ObjectID;\r\n    // Per-object baked-GI state (CalculateGI in StandardSurface / StandardLighting). _GIMode selects\r\n    // realtime-ambient (0) / baked lightmap (1) / light-probe SH (2). _LightmapUV picks the UV set\r\n    // the lightmap was baked into (1 = UV2, 0 = UV0 fallback).\r\n    int _GIMode;\r\n    int _LightmapUV;\r\n    // 8-bit rendering-layer membership. Default Everything (255) keeps lighting unchanged.\r\n    int _RenderingLayerMask;\r\n    // Per-renderer lightmap UV scale/offset, used when _GIMode == 1.\r\n    float4 _LightmapScaleOffset;\r\n    // Light-probe SH L2 coefficients (the standard 7-vec4 ShadeSH9 packing), used when _GIMode == 2.\r\n    float4 xengine_SHAr;\r\n    float4 xengine_SHAg;\r\n    float4 xengine_SHAb;\r\n    float4 xengine_SHBr;\r\n    float4 xengine_SHBg;\r\n    float4 xengine_SHBb;\r\n    float4 xengine_SHC;\r\n};\r\n\r\n#define XENGINE_MATRIX_V xengine_MatV\r\n#define XENGINE_MATRIX_VP_PREVIOUS xengine_PrevViewProj\r\n#define XENGINE_MATRIX_I_V xengine_MatIV\r\n#define XENGINE_MATRIX_P xengine_MatP\r\n#define XENGINE_MATRIX_VP xengine_MatVP\r\n#define XENGINE_MATRIX_I_P xengine_MatIP\r\n#define XENGINE_MATRIX_I_VP xengine_MatIVP\r\n#define XENGINE_MATRIX_VP_NONJITTERED xengine_MatVP_NonJittered\r\n#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\nstatic float4x4 xengine_InstanceModel;\r\nstatic float4 xengine_InstanceColor;\r\nstatic int xengine_SkinPaletteRow;\r\nstatic int xengine_MorphPaletteRow;\r\nstatic int xengine_MorphActiveCount;\r\n#define XENGINE_INSTANCE_ATTRIBUTES float4 instanceModel0 : TEXCOORD8; float4 instanceModel1 : TEXCOORD9; float4 instanceModel2 : TEXCOORD10; float4 instanceModel3 : TEXCOORD11; float4 instanceColor : TEXCOORD12; float4 instanceCustomData : TEXCOORD13;\r\n#define XENGINE_SETUP_INSTANCE(v) xengine_InstanceModel = transpose(float4x4(v.instanceModel0, v.instanceModel1, v.instanceModel2, v.instanceModel3)); xengine_InstanceColor = v.instanceColor; xengine_SkinPaletteRow = (int)v.instanceCustomData.x; xengine_MorphPaletteRow = (int)v.instanceCustomData.y; xengine_MorphActiveCount = (int)v.instanceCustomData.z\r\n#define XENGINE_MATRIX_M xengine_InstanceModel\r\n#else\r\n#define XENGINE_INSTANCE_ATTRIBUTES\r\n#define XENGINE_SETUP_INSTANCE(v)\r\n#define XENGINE_MATRIX_M xengine_ObjectToWorld\r\n#endif\r\n#define XENGINE_MATRIX_M_PREVIOUS xengine_PrevObjectToWorld\r\n\r\nfloat4x4 GetModelMatrix() { return XENGINE_MATRIX_M; }\r\n\r\n// =============================================================\r\n//  Skeletal Animation (Skinning)   clean-base reimplementation.\r\n//  Lesson from the failed first attempt (skinning-wip branch): the path was\r\n//  built and debugged on top of THREE stacked breakages, so no probe result\r\n//  was ever trustworthy. This version differs in one decisive way: boneCount\r\n//  is a compile-time constant (XENGINE_SKIN_BONE_COUNT) instead of a cbuffer  \r\n//  the old dedicated cbuffer(b10) had no binder and read 0, collapsing every\r\n//  weighted vertex. Texture slot is t15, the only slot no other shader claims\r\n//  (Standard materials t0-t3/t9/t10, lighting t4-t8/t11/t14, Toon spec t12,\r\n//  light cookie atlas t13). Bound BY NAME from SkinnedMeshRenderer.\r\n// =============================================================\r\n#ifdef SKINNED\r\n\r\nTexture2D<float4> boneMatrixTexture : register(t15);\r\n#define XENGINE_SKIN_BONE_COUNT 512\r\n\r\nstatic const int XENGINE_MAX_BONE_INFLUENCE = 4;\r\n\r\nfloat4x4 XSkinGetBoneMatrix(int boneIndex)\r\n{\r\n    // C# Float4x4 stores columns consecutively (c0..c3, one texel each), while Slang matrix\r\n    // initializers consume rows regardless of the selected uniform-memory layout. Fold the four\r\n    // uploaded columns into rows so mul(matrix, columnVector) matches the CPU transform exactly.\r\n    int t = boneIndex * 4;\r\n    int row = 0;\r\n#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\n    row = xengine_SkinPaletteRow;\r\n#endif\r\n    float4 c0 = boneMatrixTexture.Load(int3(t + 0, row, 0));\r\n    float4 c1 = boneMatrixTexture.Load(int3(t + 1, row, 0));\r\n    float4 c2 = boneMatrixTexture.Load(int3(t + 2, row, 0));\r\n    float4 c3 = boneMatrixTexture.Load(int3(t + 3, row, 0));\r\n    return float4x4(\r\n        float4(c0.x, c1.x, c2.x, c3.x),\r\n        float4(c0.y, c1.y, c2.y, c3.y),\r\n        float4(c0.z, c1.z, c2.z, c3.z),\r\n        float4(c0.w, c1.w, c2.w, c3.w));\r\n}\r\n\r\nfloat4 XSkinPosition(float3 position, uint4 boneIdx, float4 boneWgt)\r\n{\r\n    float4 skinned = float4(0.0, 0.0, 0.0, 0.0);\r\n    [unroll]\r\n    for (int i = 0; i < XENGINE_MAX_BONE_INFLUENCE; i++)\r\n    {\r\n        int boneIndex = (int)boneIdx[i];\r\n        float weight = boneWgt[i];\r\n        if (boneIndex > 0 && weight > 0.0 && boneIndex <= XENGINE_SKIN_BONE_COUNT)\r\n            skinned += mul(XSkinGetBoneMatrix(boneIndex - 1), float4(position, 1.0)) * weight;\r\n    }\r\n    if (boneWgt.x + boneWgt.y + boneWgt.z + boneWgt.w < 0.01)\r\n        skinned = float4(position, 1.0);\r\n    return skinned;\r\n}\r\n\r\nfloat3 XSkinNormal(float3 normal, uint4 boneIdx, float4 boneWgt)\r\n{\r\n    float3 skinned = float3(0.0, 0.0, 0.0);\r\n    [unroll]\r\n    for (int i = 0; i < XENGINE_MAX_BONE_INFLUENCE; i++)\r\n    {\r\n        int boneIndex = (int)boneIdx[i];\r\n        float weight = boneWgt[i];\r\n        if (boneIndex > 0 && weight > 0.0 && boneIndex <= XENGINE_SKIN_BONE_COUNT)\r\n            skinned += mul((float3x3)XSkinGetBoneMatrix(boneIndex - 1), normal) * weight;\r\n    }\r\n    return skinned;\r\n}\r\n\r\nfloat4 TransformClipSkinned(float3 objectPos, uint4 boneIdx, float4 boneWgt)\r\n{\r\n    return mul(XENGINE_MATRIX_VP, mul(XENGINE_MATRIX_M, XSkinPosition(objectPos, boneIdx, boneWgt)));\r\n}\r\n\r\nfloat3 TransformPositionSkinned(float3 objectPos, uint4 boneIdx, float4 boneWgt)\r\n{\r\n    return mul(XENGINE_MATRIX_M, XSkinPosition(objectPos, boneIdx, boneWgt)).xyz;\r\n}\r\n\r\n#endif // SKINNED\r\n\r\nfloat4 TransformClip(float3 objectPos)\r\n{\r\n    return mul(XENGINE_MATRIX_VP, mul(XENGINE_MATRIX_M, float4(objectPos, 1.0)));\r\n}\r\n\r\nfloat3 TransformPosition(float3 objectPos)\r\n{\r\n    return mul(XENGINE_MATRIX_M, float4(objectPos, 1.0)).xyz;\r\n}\r\n\r\nfloat3 TransformDirection(float3 dir)\r\n{\r\n    return normalize(mul((float3x3)XENGINE_MATRIX_M, dir));\r\n}\r\n\r\n// Camera-centered sky dome: drop view translation so the mesh is not a world-space sphere.\r\n// Perspective already fills the far plane. Ortho maps a unit dome to a tiny NDC circle\r\n// (P scales by 2/orthoSize). Scale XY well past the NDC corners so a coarse sphere\r\n// tessellation still covers the rectangle (mesh radius ~0.95, inscribed-polygon chords).\r\nfloat4 TransformSkyboxClip(float3 objectPos)\r\n{\r\n    float3 viewDir = mul((float3x3)XENGINE_MATRIX_V, objectPos);\r\n    float4 clip = mul(XENGINE_MATRIX_P, float4(viewDir, 1.0));\r\n    float4 origin = mul(XENGINE_MATRIX_P, float4(0.0, 0.0, 0.0, 1.0));\r\n    if (abs(origin.w) > 0.5)\r\n    {\r\n        clip.x = viewDir.x * 4.0 * origin.w;\r\n        clip.y = viewDir.y * 4.0 * origin.w;\r\n    }\r\n    clip.z = clip.w;\r\n    // Ortho flattens the dome along view Z, so with ZTest Off the behind-camera hemisphere\r\n    // lands on the same pixels as the sky and submission order decides each pixel.\r\n    // Perspective is safe (w = -viewZ hardware-clips it); here push those verts past the\r\n    // far plane so the clipper removes them.\r\n    if (abs(origin.w) > 0.5 && viewDir.z > 0.0)\r\n        clip.z = 2.0 * abs(clip.w) + 1.0;\r\n    return clip;\r\n}\r\n\r\nfloat3 linearToGammaSpace(float3 lin)\r\n{\r\n    return max(1.055 * pow(max(lin, 0.0.xxx), 0.416666667.xxx) - 0.055.xxx, 0.0.xxx);\r\n}\r\n\r\nfloat3 gammaToLinearSpace(float3 gamma)\r\n{\r\n    return gamma * (gamma * (gamma * 0.305306011 + 0.682171111) + 0.012522878);\r\n}\r\n\r\nfloat linearizeDepth(float depth, float nearZ, float farZ)\r\n{\r\n    float z = depth * 2.0 - 1.0;\r\n    return (2.0 * nearZ * farZ) / (farZ + nearZ - z * (farZ - nearZ));\r\n}\r\n\r\nfloat linearizeDepthFromProjection(float depth)\r\n{\r\n    return linearizeDepth(depth, _ProjectionParams.y, _ProjectionParams.z);\r\n}\r\n\r\nfloat4 EncodeViewNormal(float3 worldNormal)\r\n{\r\n    float3 viewN = normalize(mul((float3x3)XENGINE_MATRIX_V, worldNormal));\r\n    return float4(viewN * 0.5 + 0.5, _RenderingLayerMask / 255.0);\r\n}\r\n\r\nfloat3 DecodeViewNormal(float4 encoded)\r\n{\r\n    float3 viewN = encoded.xyz * 2.0 - 1.0;\r\n    return normalize(mul((float3x3)XENGINE_MATRIX_I_V, viewN));\r\n}\r\n\r\nfloat3 ApplyFog(float3 color, float3 worldPos)\r\n{\r\n    // Stub: full fog lives in Lighting.glsl; keep identity until HLSL lighting is ported.\r\n    return color;\r\n}\r\n\r\nfloat4 GetInstanceColor()\r\n{\r\n#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\n    return xengine_InstanceColor;\r\n#else\r\n    return float4(1, 1, 1, 1);\r\n#endif\r\n}\r\n\r\n// =============================================================\r\n//  Blend Shapes (morph targets)   Slang path.\r\n//  Mirrors the GLSL block in VertexAttributes.glsl: per-mesh RGBA32F delta\r\n//  textures hold one \"layer\" per blend-shape frame, laid out linearly as\r\n//  idx = layer * morphVertexCount + vertexID and tiled 2D as\r\n//  (idx % morphTexWidth, idx / morphTexWidth). The renderer uploads only the\r\n//  ACTIVE layers (non-zero weight) into morphWeightTexture, one texel each:\r\n//  (layerIndex, weight, 0, 0). Morphing happens on the rest-pose vertex\r\n//  BEFORE skinning.\r\n//\r\n//  Binding channels (both proven by the skinned path): the four textures ride\r\n//  the per-draw instance texture state by name (like boneMatrixTexture t15),\r\n//  and the five scalars ride the per-draw instance ints, which qualify the\r\n//  draw for a material-block repack   the generic reflection packer fills the\r\n//  MorphParams block declared beneath this comment on every backend that has\r\n//  one (D3D12/WebGPU). Note: avoid the word \"cbuffer\" in this comment   the\r\n//  register scanner's regex captures \"<cbuffer> <identifier>\" even in prose.\r\n//  b7 / t16-t19 are the only slots no other shader claims (b3-b6 = lighting,\r\n//  shadows, reflection probes, light cookies).\r\n// =============================================================\r\n#ifdef BLENDSHAPES\r\n\r\ncbuffer MorphParams : register(b7)\r\n{\r\n\t// No trailing vec3 padding: WGSL gives int3 a 16-byte alignment, which would make this\r\n\t// block 48 bytes there while D3D12 packs it as 32   keep plain scalars so every backend\r\n\t// reflects the same footprint.\r\n\tint morphActiveCount;\r\n\tint morphTexWidth;\r\n\tint morphVertexCount;\r\n\tint morphHasNormals;\r\n\tint morphHasTangents;\r\n};\r\n\r\nTexture2D<float4> morphPositionTexture : register(t16);\r\nTexture2D<float4> morphNormalTexture : register(t17);\r\nTexture2D<float4> morphTangentTexture : register(t18);\r\nTexture2D<float4> morphWeightTexture : register(t19);\r\n\r\nfloat3 XMorphSampleDelta(Texture2D<float4> deltaTex, int layer, uint vertexId)\r\n{\r\n\tint idx = layer * morphVertexCount + (int)vertexId;\r\n\tint2 coord = int2(idx % morphTexWidth, idx / morphTexWidth);\r\n\treturn deltaTex.Load(int3(coord, 0)).xyz;\r\n}\r\n\r\nfloat3 GetMorphedPosition(float3 position, uint vertexId)\r\n{\r\n\t#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\n\tint morphRow = xengine_MorphPaletteRow;\r\n\tint morphCount = xengine_MorphActiveCount;\r\n\t#else\r\n\tint morphRow = 0;\r\n\tint morphCount = morphActiveCount;\r\n\t#endif\r\n\tfor (int i = 0; i < morphCount; i++)\r\n\t{\r\n\t\tfloat2 lw = morphWeightTexture.Load(int3(i, morphRow, 0)).xy;\r\n\t\tposition += XMorphSampleDelta(morphPositionTexture, int(lw.x), vertexId) * lw.y;\r\n\t}\r\n\treturn position;\r\n}\r\n\r\nfloat3 GetMorphedNormal(float3 normal, uint vertexId)\r\n{\r\n\tif (morphHasNormals == 0) return normal;\r\n\t#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\n\tint morphRow = xengine_MorphPaletteRow;\r\n\tint morphCount = xengine_MorphActiveCount;\r\n\t#else\r\n\tint morphRow = 0;\r\n\tint morphCount = morphActiveCount;\r\n\t#endif\r\n\tfor (int i = 0; i < morphCount; i++)\r\n\t{\r\n\t\tfloat2 lw = morphWeightTexture.Load(int3(i, morphRow, 0)).xy;\r\n\t\tnormal += XMorphSampleDelta(morphNormalTexture, int(lw.x), vertexId) * lw.y;\r\n\t}\r\n\treturn normal;\r\n}\r\n\r\nfloat3 GetMorphedTangent(float3 tangent, uint vertexId)\r\n{\r\n\tif (morphHasTangents == 0) return tangent;\r\n\t#if defined(GPU_INSTANCING) && defined(XENGINE_STANDARD_INSTANCE_VERTEX)\r\n\tint morphRow = xengine_MorphPaletteRow;\r\n\tint morphCount = xengine_MorphActiveCount;\r\n\t#else\r\n\tint morphRow = 0;\r\n\tint morphCount = morphActiveCount;\r\n\t#endif\r\n\tfor (int i = 0; i < morphCount; i++)\r\n\t{\r\n\t\tfloat2 lw = morphWeightTexture.Load(int3(i, morphRow, 0)).xy;\r\n\t\ttangent += XMorphSampleDelta(morphTangentTexture, int(lw.x), vertexId) * lw.y;\r\n\t}\r\n\treturn tangent;\r\n}\r\n\r\n#else\r\n\r\n// No-op passthroughs so Slang vertex stages can call these unconditionally\r\n// (GLSL gets the same contract from VertexAttributes.glsl with gl_VertexID implicit).\r\nfloat3 GetMorphedPosition(float3 position, uint vertexId) { return position; }\r\nfloat3 GetMorphedNormal(float3 normal, uint vertexId) { return normal; }\r\nfloat3 GetMorphedTangent(float3 tangent, uint vertexId) { return tangent; }\r\n\r\n#endif\r\n\r\n// One-argument compatibility overloads: game shaders written before morphs reached the Slang\r\n// path (e.g. Zonezero Toon) call these. They cannot fetch deltas (no SV_VertexID in hand), so\r\n// they stay identity   upstream those call sites to the two-argument forms to opt into morphing.\r\nfloat3 GetMorphedPosition(float3 position) { return position; }\r\nfloat3 GetMorphedNormal(float3 normal) { return normal; }\r\nfloat3 GetMorphedTangent(float3 tangent) { return tangent; }\r\n\r\n#endif\r\n\n\n            Texture2D _MainTex : register(t0);\n            SamplerState _MainTexSampler : register(s0);\n\n            struct PSInput\n            {\n                float4 position : SV_Position;\n                float3 vDirection : TEXCOORD0;\n            };\n\n            float4 main(PSInput input) : SV_Target\n            {\n                float3 direction = normalize(input.vDirection);\n                float u = atan2(direction.z, direction.x) * 0.15915494 + 0.5;\n                float v = asin(clamp(direction.y, -1.0, 1.0)) * 0.31830989 + 0.5;\n                float3 color = _MainTex.Sample(_MainTexSampler, float2(u, v)).rgb;\n                return float4(color, 1.0);\n            }",
